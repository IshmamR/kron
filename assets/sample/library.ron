        (key: "summary", kind: Summary, text: "Backend engineer with eight years of experience building reliable services in Rust, Go and Python, most recently leading the routing platform at a logistics company."),
        (key: "rustconf", text: "Tracing async Rust in production, RustConf 2024.", also_in: ["linkedin"]),
        (key: "meetup", text: "Moving a Python monolith to Rust one service at a time, Rust Dhaka meetup 2023."),
        (key: "lecture", from: "lecture_note", text: "Gave a guest lecture on async Rust to final-year students at BRAC University.", status: Unreviewed),
    ],

